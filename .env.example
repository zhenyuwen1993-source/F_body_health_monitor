# Copy to ".env" and edit. Everything here is optional — the app runs with
# sensible defaults if this file is absent.

# Host/port the ingest API listens on. 0.0.0.0 lets your iPhone reach it on the LAN.
HM_API_HOST=0.0.0.0
HM_API_PORT=8000

# Optional shared secret. If set, Health Auto Export must send it as an
# "X-API-Key" header (or "Authorization: Bearer <key>"). Leave blank to disable.
HM_API_KEY=

# Optional: override where the SQLite database lives (default: ./data/health.db)
# HM_DB_PATH=./data/health.db
